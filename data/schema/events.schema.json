{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "이벤트",
  "type": "object",
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "trigger",
          "text",
          "choices"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "object",
            "required": [
              "ko"
            ],
            "properties": {
              "ko": {
                "type": "string"
              },
              "zh": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "once": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          },
          "trigger": {
            "type": "object"
          },
          "text": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "effects"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "text": {
                  "type": "string"
                },
                "ai_weight": {
                  "type": "number",
                  "minimum": 0
                },
                "effects": {
                  "type": "array"
                }
              }
            }
          },
          "effects": {
            "type": "array"
          }
        }
      }
    }
  },
  "additionalProperties": true
}